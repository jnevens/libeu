/*
 * Generated by configure from configure.ac (single source for release version).
 */
#ifndef INCLUDE_EU_VERSION_H_
#define INCLUDE_EU_VERSION_H_

#define EU_VERSION_MAJOR @DC_VERSION_MAJOR@
#define EU_VERSION_MINOR @DC_VERSION_MINOR@
#define EU_VERSION_MICRO @DC_VERSION_MICRO@
#define EU_VERSION "@DC_VERSION@"

/* Release version string (same as the tools' --version and libeu.pc). */
const char *eu_version(void);

#endif /* INCLUDE_EU_VERSION_H_ */
